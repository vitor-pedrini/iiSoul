# =========================================================
# Configuracoes de Exemplo (.env.example)
# Renomeie para .env e preencha conforme seu ambiente
# =========================================================

APP_NOME="iiKliente"
APP_URL="http://localhost/projetos/IISoul"
APP_DEBUG=true

# Banco de Dados (MySQL / MariaDB via XAMPP)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=suamarca_db
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# Envio de E-mail (PHPMailer / SMTP)
# Se deixar vazio, os e-mails serao salvos em storage/logs/emails.log
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USER=
MAIL_PASS=
MAIL_ENCRYPTION=tls
MAIL_FROM_EMAIL=vitorh.pedrini@gmail.com
MAIL_FROM_NAME="Vitor Hugo Dos Santos Pedrini"
